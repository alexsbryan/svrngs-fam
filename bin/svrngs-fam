#!/usr/bin/python3 -I
"""svrngs.fam's helper: every read and every action the bar plugin takes.

The plugin's QML never reads the token, never builds an HTTP request and
never puts a value from svrngs into a shell string. It runs this helper with
an argv list and reads one JSON object from its standard output.

Verbs:
  state [--full | --here]         svrngs's state; --full adds what each group
                                  lends and what listens on this computer,
                                  --here only what listens on this computer
  share <port> <group> <name> [--program <kind>] [--pid <pid>@<start>] [--password-stdin]
                                  lends it as svrngs knows its port, else as
                                  --program; with neither, asks which program
  approve <name> --token <token> --pid <pid>@<start>
                                  keeps sharing a held share to what its row
                                  showed answering on its port: the token
                                  the row was listed with, and the process
                                  of this account's its line named
  unshare <name> [--group <group>]
  models [--skip <label,...>]     friends' lends that answer OpenAI's
                                  v1/models, each with its lender's key, which
                                  Play is asked by;
                                  those named in --skip are listed, not asked
  play <key> <name> [--off]       Play on for a friend's lend at an address,
                                  so this account's programs reach it there
                                  with no key, and that address copied with
                                  v1 on its end; --off turns it off
  open [--lend <label>] [--at <path>]
                                  opens it in the browser, signed in
  link <group>                    makes a new invite link and copies it
  start                           starts svrngs again, as svrngs restart does
  get [--link <invite link>]      installs svrngs with its own installer, once
                                  the installer's signature verifies against
                                  the svrngs release key in ../keys, made no
                                  earlier than svrngs 1.13.3's (SIGNED_SINCE)

It reads svrngs's public surface only: the `svrngs` command, the `api` and
`token` files in svrngs's data directory, and the `/v1/` routes behind the
token, which it sends only once svrngs has proved it holds it (`dial`). It
also reads `lends/*.json` there, a file format svrngs does not promise, for
the one fact no route gives: which port each lend serves.
"""

import calendar
import collections
import hashlib
import hmac
import http.client
import json
import os
import pwd
import re
import secrets
import shutil
import subprocess
import sys
import tempfile
import threading
import time
import urllib.error
import urllib.request
from concurrent.futures import ThreadPoolExecutor
from pathlib import Path

MAX_BODY = 256 * 1024
MAX_ROWS = 200
MAX_TEXT = 200
TIMEOUT = 5.0
LENDS_TIMEOUT = 8.0  # each lender gets up to 3 s to answer (svrngs DESIGN.md:714-727)

# Never offered for lending: ports and programs that act as this person or
# show their sessions. In svrngs's Omarchy testing one Enter on a default row
# lent a browser's debug port (docs/OMARCHY.md §5 G).
DENY_PORTS = {9222, 9229}
DENY_PROGRAMS = {"firefox", "chromium", "chrome", "claude", "cupsd", "svrngs"}
# A lend opened to this Wi-Fi listens at 40000 + hash(label) % 9000
# (svrngs room.rs:63-69).
ROOM_PORTS = range(40000, 49000)


def text(value):
    """A string from svrngs or the system, bounded."""
    s = "" if value is None else str(value)
    return s if len(s) <= MAX_TEXT else s[: MAX_TEXT - 1] + "…"


def rows(values):
    values = list(values or [])
    return values[:MAX_ROWS], len(values) > MAX_ROWS


def data_dir():
    named = os.environ.get("SVRNGS_DIR")
    return Path(named) if named else Path.home() / ".svrngs"


def svrngs_command():
    """The svrngs binary: SVRNGS_FAM_SVRNGS when set (empty for none, as the
    tests set it, so no test reaches a real svrngs), else on PATH, else where
    its install line puts it."""
    if "SVRNGS_FAM_SVRNGS" in os.environ:
        named = os.environ["SVRNGS_FAM_SVRNGS"]
        return named if named and os.access(named, os.X_OK) else None
    found = shutil.which("svrngs")
    if found:
        return found
    candidate = Path.home() / ".local/bin/svrngs"
    return str(candidate) if candidate.is_file() and os.access(candidate, os.X_OK) else None


class Unreadable(Exception):
    """svrngs answered, or something stood in the way, but not as asked."""


class Stopped(Exception):
    """Nothing listens at the address svrngs last kept."""


class Older(Unreadable):
    """What answers at svrngs's address has no proof route: an svrngs from
    before 1.13.3, told NEWER."""

    def __init__(self):
        super().__init__(NEWER)


def address(root):
    """(host, port) from svrngs's `api` file, which names the port it keeps."""
    try:
        line = (root / "api").read_text().strip()
    except FileNotFoundError:
        return None
    match = re.fullmatch(r"http://127\.0\.0\.1:(\d{1,5})/?", line)
    if not match or not 0 < int(match.group(1)) < 65536:
        raise Unreadable(f"its api file says {text(line)!r}, which is not a local address")
    return "127.0.0.1", int(match.group(1))


def token(root):
    try:
        value = (root / "token").read_text().strip()
    except OSError as e:
        raise Unreadable(f"its token cannot be read: {e.strerror}") from None
    if not re.fullmatch(r"[A-Za-z0-9_-]{16,128}", value):
        raise Unreadable("its token file holds no token")
    return value


def ask(at, secret, method, path, body=None, timeout=TIMEOUT):
    """One request to svrngs's API, its JSON answer; any other is Unreadable."""
    status, answer = request(at, secret, method, path, body, timeout)
    if answer is None:
        raise Unreadable(f"{path} answered {status} with no JSON")
    if status >= 400:
        said = answer.get("error") if isinstance(answer, dict) else None
        raise Unreadable(f"{path} answered {status}: {text(said)}")
    return answer


# svrngs proves it holds the token before the helper sends it, on the
# connection the helper then sends it on (svrngs POST /v1/proof, from
# 1.13.3). The helper asks with a challenge, 32 random bytes in hex, new
# each time. svrngs answers with HMAC-SHA256, keyed by the token as its
# token file keeps it, of PROOF_OF, the challenge, and that connection's
# two ends as svrngs sees them: the helper's, then its own (`proof`). A
# program without the token can't make it. Nor can a relay pass on
# svrngs's own: svrngs would make it for the relay's connection, whose ends
# aren't the helper's.
PROOF_OF = "svrngs proof v1"
# How long, in seconds, the helper waits for svrngs's proof. svrngs listens
# before it answers while it starts: node.rs `start_on` binds its API
# (api.rs `bind`), then builds the rest before it serves, and a connection
# made meanwhile waits for it. Nothing without the token can prove itself,
# however long it is given.
PROOF_WITHIN = 10.0
# The most of an answer to a challenge the helper reads; one with a proof
# in it is under a hundred bytes.
MAX_PROOF = 4096
PROVED = re.compile(r"[0-9a-f]{64}")


def proof(secret, challenge, client, server):
    """svrngs's proof that it holds `secret`, for `challenge` asked on the
    connection from `client` to `server`, in lowercase hex."""
    said = f"{PROOF_OF}\n{challenge}\n{client}\n{server}"
    return hmac.new(secret.encode(), said.encode(), hashlib.sha256).hexdigest()


def end(name):
    """One end of a connection as svrngs names it, by Rust's SocketAddr:
    127.0.0.1:50000, or [::1]:50001. `name` is a socket's, as Python gives
    it: (host, port), and for IPv6 two numbers more."""
    host, port = name[:2]
    return f"[{host}]:{port}" if ":" in host else f"{host}:{port}"


def shown_proof(raw):
    """The proof in an answer to a challenge, `{"proof": "<hex>"}`, or ""
    when it holds none in that shape."""
    try:
        said = json.loads(raw) if len(raw) <= MAX_PROOF else None
    # Whatever reading it raises: a ValueError for what isn't JSON, and a
    # RecursionError for nesting deeper than this Python's stack goes.
    except Exception:
        return ""
    shown = said.get("proof") if isinstance(said, dict) else None
    return shown if isinstance(shown, str) and PROVED.fullmatch(shown) else ""


def other(port):
    """What the panel says when what answers at svrngs's address doesn't
    prove it holds the token."""
    return (f"something other than your svrngs answers at svrngs's address, port {port}, so the panel sent it none of your token. "
            "svrngs can't start there until that program stops")


def proved(conn, secret, port):
    """The socket of `conn`, just connected to svrngs's address, once what
    answers there has proved it holds `secret` on it (PROOF_OF), sent the
    challenge and nothing else. Refused as Unreadable, the token sent
    nowhere: Older when svrngs has no such route, an svrngs before 1.13.3;
    any other answer, a proof that isn't svrngs's for this connection
    among them; no answer within PROOF_WITHIN; and a connection that closes
    after the proof, which leaves none to send on."""
    sock = conn.sock
    # The helper's end is the one svrngs sees the connection from, and the
    # end the helper reached is svrngs's own.
    client, server = end(sock.getsockname()), end(sock.getpeername())
    challenge = secrets.token_bytes(32).hex()
    sock.settimeout(PROOF_WITHIN)
    try:
        conn.request("POST", "/v1/proof", body=json.dumps({"challenge": challenge}).encode(),
                     headers={"Content-Type": "application/json"})
        reply = conn.getresponse()
        raw = reply.read(MAX_PROOF + 1)
    except TimeoutError:
        raise Unreadable(f"what listens at svrngs's address, port {port}, didn't show it is your svrngs within "
                         f"{PROOF_WITHIN:.0f} seconds, so the panel sent it none of your token. If svrngs is starting, try again in a moment") from None
    except (OSError, http.client.HTTPException):
        raise Unreadable(f"what listens at svrngs's address, port {port}, closed the connection before it showed it is your svrngs, "
                         "so the panel sent it none of your token") from None
    if reply.status == 404:
        raise Older()
    if reply.status != 200 or not hmac.compare_digest(shown_proof(raw), proof(secret, challenge, client, server)):
        raise Unreadable(other(port))
    # The answer read whole, and the connection still open: one whose
    # answer said to close it, http.client has closed (`getresponse`).
    if conn.sock is not sock or not reply.isclosed():
        raise Unreadable(f"svrngs closed the connection it proved itself on, at port {port}, so the panel sent it none of your token. "
                         "Try again in a moment")
    return sock


class Proven:
    """A connection on which svrngs proved it holds the token (`dial`),
    and the one way the helper sends that token: on that socket, never
    another. http.client connects again by itself to send on a connection
    an answer closed (HTTPConnection.send, while its auto_open is set),
    which `dial` turns off, and each request is sent only while the
    connection holds the socket svrngs proved itself on."""

    def __init__(self, conn, sock, secret, timeout):
        self.conn, self.sock, self.secret = conn, sock, secret
        sock.settimeout(timeout)

    def send(self, method, path, payload=None, headers=None):
        """svrngs's reply to one request, sent with the token."""
        if self.conn.sock is not self.sock:
            raise Unreadable(f"{path} wasn't asked: the connection svrngs proved itself on had closed")
        self.conn.request(method, path, body=payload, headers={**(headers or {}), "Authorization": f"Bearer {self.secret}"})
        return self.conn.getresponse()

    def close(self):
        self.conn.close()


def dial(at, secret, timeout=TIMEOUT):
    """A connection to svrngs's address on which svrngs has proved it holds
    `secret` (`proved`), sent nothing else yet. svrngs's port is free while
    svrngs is stopped, and any program on this computer can listen there
    then, a sandbox of this account's that can't read the token among them;
    what is sent with the token acts as this person everywhere. Stopped
    when nothing listens there; else Unreadable, the token sent nowhere,
    until svrngs proves it. An svrngs older than the one its login service
    starts, as one an update replaced keeps running until it restarts, is
    restarted once (`renewal`), then waited for and asked again."""
    try:
        return connected_to(at, secret, timeout)
    except Older:
        kept = renewal(at[1])
    began = time.monotonic()
    while True:
        try:
            proven = connected_to(at, secret, timeout)
        except Stopped:
            # Not listening yet: svrngs binds its API first as it starts.
            if time.monotonic() - began > PROOF_WITHIN:
                raise
            time.sleep(0.1)
            continue
        except Older:
            raise Unreadable(still_older(kept, at[1])) from None
        RESTART["proven"] = True
        return proven


def connected_to(at, secret, timeout):
    """One connection to svrngs's address, proved on (`proved`)."""
    host, port = at
    conn = http.client.HTTPConnection(host, port, timeout=timeout)
    conn.auto_open = 0
    try:
        conn.connect()
    except ConnectionRefusedError:
        raise Stopped() from None
    except OSError as e:
        raise Unreadable(f"svrngs's address did not answer: {e}") from None
    try:
        return Proven(conn, proved(conn, secret, port), secret, timeout)
    except BaseException:
        conn.close()
        raise


# Whether this run of the helper, one read or action of the panel's, has
# tried to restart svrngs, and been proved to after it. Held under
# RESTARTING, since a read asks svrngs from several threads at once. A
# restart is remembered across runs too (`stamped`): the panel runs the
# helper again each time svrngs rewrites its `api` file, which it does at
# every start.
RESTART = {"tried": False, "proven": False}
RESTARTING = threading.Lock()
RESTARTED = "svrngs was updated, so it restarted to use the new one."

# svrngs's login service as systemd keeps it: `svrngs restart` restarts
# svrngs.service (svrngs cli.rs `restart`), whose unit is svrngs-bin's
# (/usr/lib/systemd/user/svrngs.service) or svrngs's install line's
# (~/.config/systemd/user/svrngs.service, which keeps the data dir it was
# given as SVRNGS_DIR; svrngs web/install.sh).
Kept = collections.namedtuple("Kept", "program data version")


def renewal(port):
    """The service restarted, once, because what answers at svrngs's
    address is an svrngs from before 1.13.3 (Older) and the one its login
    service starts isn't; or Unreadable, saying why not, the token sent
    nowhere. An update replaces svrngs's file while svrngs runs on until it
    restarts (svrngs-bin.install says to run `svrngs restart`). Restarted
    only while an svrngs holds the data dir (`held`), so a program that
    isn't svrngs never restarts it; only for the service that keeps this
    data dir; only when the program it starts is NEEDS or later; and once
    for that program and version (`stamped`)."""
    root = data_dir()
    if not held(root / "lock"):
        raise Unreadable(other(port))
    with RESTARTING:
        if RESTART["tried"]:
            raise Older()
        RESTART["tried"] = True
        kept = service()
        if kept is None or kept.data != os.path.realpath(root):
            raise Older()
        if kept.version is None or kept.version < FLOOR:
            raise Unreadable(f"This needs svrngs {NEEDS} or later. Your login service starts {kept.program}, {is_version(kept)}: "
                             "update it on its home page, then try again.")
        first = stamped(kept)
        if first is None:
            raise Unreadable(f"The svrngs running here is older than {kept.program} ({version_of(kept)}). "
                             "Restart it to use that one: svrngs restart")
        if not first:
            raise Unreadable(still_older(kept, port))
        try:
            done = subprocess.run([kept.program, "restart"], stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=60)
        except (OSError, subprocess.SubprocessError) as e:
            done = subprocess.CompletedProcess([], 1, "", str(e))
    if done.returncode != 0:
        said = text(done.stderr.strip().splitlines()[0] if done.stderr.strip() else f"it stopped (exit {done.returncode})")
        raise Unreadable(f"The svrngs running here is older than {kept.program} ({version_of(kept)}), and restarting it didn't work: "
                         f"{said.rstrip('.')}. See why with: systemctl --user status svrngs")
    return kept


def still_older(kept, port):
    """What the panel says when svrngs restarted, for `kept`, and what
    answers is still from before 1.13.3."""
    return (f"svrngs was restarted to use {kept.program} ({version_of(kept)}), but the svrngs answering at port {port} is still older, "
            "so the panel sent it none of your token. See why with: systemctl --user status svrngs")


def version_of(kept):
    return ".".join(str(n) for n in kept.version) if kept.version else "no version"


def is_version(kept):
    return f"which is {version_of(kept)}" if kept.version else "which says no version this panel can read"


def held(lock):
    """Whether a process holds `lock`, svrngs's data-dir lock, as svrngs
    holds it while it runs (svrngs cli.rs `claim`: File::try_lock, a flock
    on Linux). Read from /proc/locks, never by taking it, which would make
    an svrngs starting just then refuse the data dir as held: a FLOCK on its
    inode by a process that has that very file open. /proc/locks names the
    file by its filesystem's device, which btrfs numbers apart from what
    stat says, so it is matched by its inode, then by that process's open
    files (proc(5))."""
    try:
        want = os.stat(lock)
        rows = Path("/proc/locks").read_text().splitlines()
    except OSError:
        return False
    for row in rows:
        # "74: FLOCK  ADVISORY  WRITE 1762 00:26:81292995 0 EOF"; a waiting
        # one reads "74: -> FLOCK …".
        f = row.split()
        if len(f) > 5 and f[1] == "FLOCK" and f[4].isdigit() and f[5].rpartition(":")[2] == str(want.st_ino):
            if opens(int(f[4]), want):
                return True
    return False


def opens(pid, want):
    """Whether process `pid` has the file `want` (a stat) open."""
    try:
        fds = os.scandir(f"/proc/{pid}/fd")
    except OSError:
        return False
    with fds:
        for fd in fds:
            try:
                s = os.stat(fd.path)
            except OSError:
                continue
            if (s.st_dev, s.st_ino) == (want.st_dev, want.st_ino):
                return True
    return False


def service():
    """svrngs's login service, as `systemctl --user show` says it: the
    program its ExecStart runs, the data dir it keeps (its SVRNGS_DIR, else
    ~/.svrngs, as svrngs takes it), and that program's version (`version`).
    None when systemd keeps no such service here."""
    systemctl = shutil.which("systemctl")
    if systemctl is None:
        return None
    try:
        done = subprocess.run([systemctl, "--user", "show", "svrngs.service", "--property=LoadState,ExecStart,Environment"],
                              stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.SubprocessError):
        return None
    said = dict(line.partition("=")[::2] for line in done.stdout.splitlines())
    program = re.match(r"\{ path=(/\S+) ;", said.get("ExecStart", ""))
    if done.returncode != 0 or said.get("LoadState") != "loaded" or program is None:
        return None
    named = re.search(r"(?:^| )SVRNGS_DIR=(/\S+)", said.get("Environment", ""))
    data = named.group(1) if named else str(Path.home() / ".svrngs")
    return Kept(program.group(1), os.path.realpath(data), version(program.group(1)))


def stamped(kept):
    """Whether this is the first restart for `kept`: its program, at its
    version, for its data dir. A file for it, made in this person's runtime
    directory, which a logout clears; True only for the run that made it.
    None when there is no such directory to remember it in."""
    runtime = os.environ.get("XDG_RUNTIME_DIR")
    if not runtime or not Path(runtime).is_dir() or Path(runtime).stat().st_uid != os.getuid():
        return None
    folder = Path(runtime) / "svrngs-fam"
    try:
        folder.mkdir(mode=0o700, exist_ok=True)
        name = hashlib.sha256(f"{kept.data}\n{kept.program}\n{version_of(kept)}".encode()).hexdigest()[:32]
        os.close(os.open(folder / f"restarted-{name}", os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600))
    except FileExistsError:
        return False
    except OSError:
        return None
    return True


# A version as `svrngs version` prints it (svrngs cli.rs `Verb::Version`):
# "svrngs 1.13.3 (<commit>)", or without the commit.
VERSION = re.compile(r"svrngs (\d{1,5})\.(\d{1,5})\.(\d{1,5})(?: \([0-9a-f]{1,64}\))?")


def version(program):
    """The version svrngs's program `program` says, as (major, minor,
    patch), or None when it says none."""
    try:
        done = subprocess.run([program, "version"], stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.SubprocessError):
        return None
    said = VERSION.fullmatch(done.stdout.strip()) if done.returncode == 0 else None
    return tuple(int(n) for n in said.groups()) if said else None


def request(at, secret, method, path, body=None, timeout=TIMEOUT):
    """One request to svrngs's API: its status, and its JSON, or None when
    it answered something else. Sent only on a connection svrngs proved
    itself on (`dial`). No Origin is sent: svrngs refuses a request that
    carries one, as coming from a page (api.rs:199-210)."""
    proven = dial(at, secret, timeout)
    headers, payload = {}, None
    if body is not None:
        payload = json.dumps(body).encode()
        headers["Content-Type"] = "application/json"
    try:
        reply = proven.send(method, path, payload, headers)
        raw = reply.read(MAX_BODY + 1)
    except (OSError, http.client.HTTPException) as e:
        raise Unreadable(f"{path} did not answer: {e}") from None
    finally:
        proven.close()
    if len(raw) > MAX_BODY:
        raise Unreadable(f"{path} answered more than {MAX_BODY // 1024} KiB")
    try:
        return reply.status, json.loads(raw) if raw else {}
    except ValueError:
        return reply.status, None


def own_lends(root):
    """This computer's lends, from their declarations, with the port each serves."""
    folder = root / "lends"
    found = []
    if not folder.is_dir():
        return found
    for path in sorted(folder.glob("*.json")):
        try:
            declared = json.loads(path.read_text())
        except (OSError, ValueError):
            found.append({"name": text(path.stem), "port": None, "readable": False})
            continue
        groups = declared.get("groups") if isinstance(declared, dict) else None
        found.append({
            "name": text(path.stem),
            "port": port_of(declared),
            "groups": [text(g) for g in groups if isinstance(g, str)][:MAX_ROWS] if isinstance(groups, list) else [],
            "readable": True,
        })
    return rows(found)[0]


def port_of(declared):
    """The port in a lend's declaration, wherever its format keeps it."""
    if not isinstance(declared, dict):
        return None
    for key in ("port", "source"):
        value = declared.get(key)
        if isinstance(value, int):
            return value
        if isinstance(value, dict):
            inner = port_of(value) or value.get("Port")
            if isinstance(inner, int):
                return inner
    return None


SS_LINE = re.compile(r"^\S+\s+\d+\s+\d+\s+(?P<local>\S+)\s+\S+\s*(?P<process>.*)$")
SS_PROC = re.compile(r'\(\("(?P<name>[^"]+)",pid=(?P<pid>\d+)')


def listening():
    """Each port something listens on over TCP, on loopback or every address,
    with who listens there in `ss`'s order: (command, pid) for this user's
    processes, None for one `ss -p` doesn't name, which is someone else's.
    None when `ss` can't be run."""
    try:
        out = subprocess.run(["ss", "-ltnpH"], capture_output=True, text=True, timeout=TIMEOUT).stdout
    except (OSError, subprocess.TimeoutExpired):
        return None
    found = {}
    for line in out.splitlines():
        match = SS_LINE.match(line.strip())
        if not match:
            continue
        host, _, port = match.group("local").rpartition(":")
        if not port.isdigit():
            continue
        if host not in ("127.0.0.1", "[::1]", "0.0.0.0", "*", "[::]") and not host.startswith("127."):
            continue
        proc = SS_PROC.search(match.group("process"))
        found.setdefault(int(port), []).append((proc.group("name"), int(proc.group("pid"))) if proc else None)
    return found


# Programs that listen on a port only to pass each connection on to
# another program, so their name says nothing of what answers: pasta and
# rootlessport for a rootless container's published port, slirp4netns,
# docker-proxy, gvproxy and vpnkit for others', socat, and ssh's own
# forwards (`ssh -L` here, `ssh -R` through sshd).
FORWARDERS = re.compile(r"(pasta|passt)(\.avx2)?|rootlessport|rootlesskit|slirp4netns|docker-proxy|gvproxy|vpnkit|socat|sshd?")


def kept_back(port, *commands):
    """Whether the panel never lends `port`, or a program by any of these
    names, as on its deny list."""
    return port in DENY_PORTS or any(c in DENY_PROGRAMS for c in commands)


def lendable(port, holder):
    """The listener `holder` on `port` as the panel would lend it: its pid,
    the start svrngs checks it by, its program and the name to offer, and
    whether it only passes the port on (`through`, FORWARDERS), so its
    program is shown but never said to svrngs as what answers; or None
    when the panel never lends it (someone else's, on the deny list, or
    gone before its start was read)."""
    if holder is None or kept_back(port, holder[0]):
        return None
    command, pid = holder
    start = started(pid)
    if start is None:
        return None
    program, offered = describe(pid, command)
    return {"pid": pid, "start": start, "program": text(program), "name": offered,
            "through": bool(FORWARDERS.fullmatch(command))}


def listeners(listed, skip_ports):
    """What could be lent from here: on each port, the first listener the
    panel lends. None when `ss` couldn't be read."""
    if listed is None:
        return None
    seen = []
    for port, holders in sorted(listed.items()):
        if port in skip_ports or port in ROOM_PORTS:
            continue
        offer = next(filter(None, (lendable(port, h) for h in holders)), None)
        if offer:
            seen.append({"port": port, **offer})
    return rows(seen)[0]


def answering_now(listed, port):
    """What listens on one of this computer's lends' ports, by this
    computer's own read: None when nothing does; else the listener as
    `lendable` gives it, with no pid or start when the panel doesn't lend
    it. The panel reads it only to notice a change while it is open, and
    then asks svrngs again (Model.js `portsKey`): what a line shows is
    svrngs's read (`svrngs_now`)."""
    holders = listed.get(port) or []
    if not holders:
        return None
    found = next(filter(None, (lendable(port, h) for h in holders)), None)
    return found or OTHER


# What answers on a port, as the panel shows what it doesn't lend: no pid
# or start, so nothing for Keep sharing it to name.
OTHER = {"pid": None, "start": None, "program": "", "folder": ""}


def svrngs_now(row, port):
    """What answers on the port of a lend of this computer's that svrngs
    holds, as svrngs read it for the lend's row (svrngs door.rs `offered`),
    the read its token names: what its line shows, and what Keep sharing it
    approves. None when nothing answers there: svrngs named nothing and its
    port took no connection. Else, when every one svrngs names is a program
    of this account, the first: by its process, which Keep sharing it keeps
    the share to, and by the program and the whole folder svrngs read, never
    by a process title the program sets itself or the folder's last name,
    which two projects may share. When another account's program is among
    them, that account, by its name (`account_name`), and no process: the
    panel lends only this account's programs, as Lend does (`lendable`), so
    nothing here keeps the share to it, though svrngs would approve it by
    the token alone on Linux. Its `said` names every one svrngs listed, as
    svrngs's home page says them (lent-row.js `answering`). Or OTHER when
    the panel doesn't lend what answers and says no more of it: svrngs gave
    no token for it, so approving it wouldn't be taken (svrngs share.rs
    `approve`, the one decider); a program on the deny list; or an answer
    svrngs couldn't name."""
    answers = row["answers"]
    if not answers:
        return None if row.get("answering") is False else OTHER
    programs = [a for a in answers if "pid" in a]
    if row["token"] is None or any("pid" not in a and not a["account"] for a in answers):
        return OTHER
    if kept_back(port) or any(kept_back(port, a["program"], command_of(a["pid"])) for a in programs):
        return OTHER
    first, said = answers[0], answered(answers)
    accounts = [a for a in answers if "pid" not in a]
    if accounts:
        return {**OTHER, "account": account_name(accounts[0]["account"]), "said": said}
    return {"pid": first["pid"], "start": first["start"], "program": text(first["program"]),
            "folder": text(first.get("folder") or ""), "said": said}


def account_name(said):
    """Another account as svrngs names it, a uid on Linux, said by its name
    on this computer (pwd): "root" for 0. The number, as svrngs gave it,
    where this computer has no account of it."""
    try:
        return text(pwd.getpwuid(int(said)).pw_name)
    except (KeyError, OverflowError, ValueError):
        return text(said)


def command_of(pid):
    """Process `pid`'s command (/proc/<pid>/comm), "" when it has gone."""
    try:
        return Path(f"/proc/{pid}/comm").read_text().strip()
    except OSError:
        return ""


def started(pid):
    """When process `pid` started, in clock ticks after boot: field 22 of
    /proc/<pid>/stat (proc(5)), the start svrngs checks a --pid by. Field 2 is
    its command in parentheses, which may hold spaces and parentheses of its
    own, so the fields are counted after the last ')'. None when it can't be
    read: the process has gone."""
    try:
        stat = Path(f"/proc/{pid}/stat").read_bytes()
    except OSError:
        return None
    _, closed, after = stat.rpartition(b")")
    fields = after.split()
    if not closed or len(fields) < 20 or not fields[19].isdigit():
        return None
    return int(fields[19])


# Puma rewrites its process title: `puma 8.1.2 (tcp://127.0.0.1:3000) [garden]`,
# while `ss` names it `ruby` (S0 (e)).
TITLE = re.compile(r"(?P<program>[A-Za-z][\w.-]*) [^\[]*\[(?P<name>[^\]]+)\]\s*")


def describe(pid, comm):
    """(program, name to offer) for a listener: from its process title when
    it names itself, else its command and the folder it runs in."""
    try:
        argv = Path(f"/proc/{pid}/cmdline").read_bytes().split(b"\0")
        title = argv[0].decode(errors="replace").strip()
    except OSError:
        title = ""
    named = TITLE.fullmatch(title)
    if named:
        return named.group("program"), lend_name(named.group("name"), comm)
    try:
        folder = Path(os.readlink(f"/proc/{pid}/cwd"))
    except OSError:
        folder = None
    if folder is None or folder == Path.home() or folder == Path("/"):
        return comm, lend_name(comm, comm)
    return comm, lend_name(folder.name, comm)


def lend_name(wanted, fallback):
    """A name svrngs takes for a lend: letters, digits and dashes."""
    cleaned = re.sub(r"[^a-z0-9-]+", "-", wanted.lower()).strip("-")[:40].strip("-")
    return cleaned or re.sub(r"[^a-z0-9-]+", "-", fallback.lower()).strip("-") or "app"


def state(full):
    root = data_dir()
    report = {"at": int(time.time() * 1000), "svrngs": None, "groups": [], "mine": [], "command": svrngs_command() is not None}
    try:
        at = address(root)
        if at is None:
            report["svrngs"] = "not-installed" if not report["command"] else "never-started"
            return report
        report["mine"] = own_lends(root)
        secret = token(root)
        held = ask(at, secret, "GET", "/v1/groups")
        groups, over = rows(held.get("groups"))
        report["groups"] = [
            {"id": text(g.get("id")), "name": text(g.get("name")), "person": text(g.get("person")), "left": bool(g.get("left"))}
            for g in groups
            if isinstance(g, dict)
        ]
        report["groupsCut"] = over
        # This computer's key, which tells its own lends from the rest:
        # each lend's row carries its lender computer's (`lends_of`).
        report["key"] = key_of(held.get("key"))
        report["svrngs"] = "running"
        if full == "full":
            # Asked together: the panel waits on the slowest group, not the sum.
            asked = [g["id"] for g in report["groups"] if not g["left"]]
            with ThreadPoolExecutor(max_workers=8) as pool:
                report["lends"] = dict(zip(asked, pool.map(lambda ns: lends_of(at, secret, ns), asked)))
            # What has Play on, so a friend's model's line says so.
            report["play"] = plays_of(at, secret)
            # A held lend of this computer's, as its line shows it: what
            # svrngs read answering on its port for that row. Only a row
            # of this computer's key: a display name is anyone's to take.
            ports = {m["name"]: m["port"] for m in report["mine"]}
            for lends in report["lends"].values():
                for l in lends.get("lent", []):
                    if l["answers"] is not None and l["key"] is not None and l["key"] == report["key"]:
                        l["now"] = svrngs_now(l, ports.get(l["name"]))
        if full in ("full", "here"):
            listed = listening()
            skip = {at[1]} | {m["port"] for m in report["mine"] if m["port"]}
            report["listeners"] = listeners(listed, skip)
            # What listens on each lend's port, from the same read, so the
            # panel notices a change and asks svrngs again.
            for m in report["mine"] if listed is not None else []:
                if isinstance(m["port"], int):
                    m["now"] = answering_now(listed, m["port"])
    except Stopped:
        report["svrngs"] = "stopped"
    except Unreadable as e:
        report["svrngs"] = "unreadable"
        report["reason"] = str(e)
    return report


# Why svrngs holds a lend closed, so nobody can open it while its program
# runs (svrngs lend.rs `Hold`): what answers on its port isn't what its
# lender approved, "another"; what answers can't be read, "unjudged"; or
# nothing was approved yet, "unapproved", as for a share made before svrngs
# 1.13.0 (door.rs `answering`). svrngs says it in its lender's own list
# alone; a member's says none (door.rs `offered`).
HELD = ("another", "unjudged", "unapproved")

# The token a held lend's row is listed with, which approving what the row
# showed sends back: opaque, a SHA-256 in hex from svrngs (share.rs `token`).
LISTED_WITH = re.compile(r"[A-Za-z0-9._~][A-Za-z0-9._~-]{0,255}")


# A computer's key as svrngs names it: its ed25519 public key in hex
# (svrngs-core sig.rs `actor_of`).
KEY = re.compile(r"[0-9a-f]{64}")


def key_of(value):
    """A computer's key svrngs gave, or None when what it gave is none."""
    return value if isinstance(value, str) and KEY.fullmatch(value) else None


def counted(value):
    """Whether `value` is a whole number svrngs counts with, not a bool."""
    return isinstance(value, int) and not isinstance(value, bool) and value >= 0


def answers_of(value):
    """What svrngs read answering on a held lend's port for its row (lend.rs
    `Answer`): a program of this account by its pid, start, executable and
    folder, or another account's; one in neither shape is kept as neither,
    and never lent. None when the row says nothing: a member's row, a lend
    svrngs doesn't hold, or an svrngs from before 1.13.0."""
    if not isinstance(value, list):
        return None
    found = []
    for a in rows(value)[0]:
        a = a if isinstance(a, dict) else {}
        if counted(a.get("pid")) and counted(a.get("start")) and isinstance(a.get("program"), str):
            folder = a.get("folder")
            found.append({"pid": a["pid"], "start": a["start"], "program": text(a["program"]),
                          "folder": text(folder) if isinstance(folder, str) else None})
        else:
            found.append({"account": text(a.get("account")) if isinstance(a.get("account"), str) else ""})
    return found


# Why svrngs couldn't read what answers on a held lend's port (svrngs
# uid.rs `Unread`, a closed set): it has no reader on this system, or the
# read failed. svrngs says it in its lender's own list alone, with no
# `answers`.
UNREAD = ("no_reader", "failed")


def unread_of(value):
    """A row's `unread` as the panel reads it: None only when svrngs says
    nothing of it; a reason this helper doesn't know, from a newer svrngs,
    is "unknown", and unread all the same."""
    if value is None:
        return None
    why = value.get("why") if isinstance(value, dict) else None
    return why if why in UNREAD else "unknown"


def held_of(value):
    """A lend's `held` as the panel reads it: None only when svrngs says
    nothing holds it. A value this helper doesn't know, from a newer svrngs,
    is "unknown", and held all the same."""
    if value is None or value is False or value == "":
        return None
    return value if value in HELD else "unknown"


def lends_of(at, secret, namespace):
    try:
        answer = ask(at, secret, "GET", f"/v1/lends?namespace={namespace}", timeout=LENDS_TIMEOUT)
    except (Unreadable, Stopped) as e:
        return {"error": text(str(e) or "svrngs stopped")}
    lent, over = rows(answer.get("lent"))
    return {
        "lent": [
            {
                "person": text(l.get("person")),
                # The computer that lends it, by its key, as svrngs dialled
                # it (svrngs node.rs `lends_in`), never as its row says.
                "key": key_of(l.get("key")),
                "name": text(l.get("name")),
                "kind": text(l.get("kind")),
                "origin": text(l.get("origin")),
                "using": l.get("using") if isinstance(l.get("using"), int) else None,
                "limit": l.get("limit") if isinstance(l.get("limit"), int) else None,
                # Whether its program answered its lender just now; None from
                # an svrngs that does not say (svrngs door.rs `answering`).
                "answering": l.get("answering") if isinstance(l.get("answering"), bool) else None,
                "held": held_of(l.get("held")),
                # For a held lend of this computer's: what svrngs read on its
                # port, and the token approving that sends back.
                "answers": answers_of(l.get("answers")),
                # Why svrngs couldn't read what answers there, said apart
                # from nothing answering (svrngs uid.rs `Unread`).
                "unread": unread_of(l.get("unread")),
                "token": l["token"] if isinstance(l.get("token"), str) and LISTED_WITH.fullmatch(l["token"]) else None,
                # An app the group's folder carries, served by every computer
                # in it: listed once, as the group's, not one person's.
                "carried": bool(l.get("group")),
            }
            for l in lent
            if isinstance(l, dict)
        ],
        "cut": over,
        "unanswered": [text(p.get("person")) for p in rows(answer.get("unanswered"))[0] if isinstance(p, dict)],
    }


# The first svrngs the panel works with: 1.13.3 carries svrngs's update
# floor (svrngs update.rs `BUILT`, at 031211d4), Play at a lend's address
# (svrngs play.rs, at 2fe16c08) and the proof svrngs gives before the
# helper sends its token (POST /v1/proof, `proved`). An svrngs older than
# that has no such route, and is told NEWER; Get svrngs installs none
# signed before SIGNED_SINCE.
NEEDS = "1.13.3"
FLOOR = tuple(int(n) for n in NEEDS.split("."))
NEWER = f"This needs svrngs {NEEDS} or later. Update svrngs on its home page, then try again."
# When 2fe16c08 was committed, in seconds since 1970 (`git log -1
# --format=%ct 2fe16c08` in svrngs). A release is signed after the commit
# it is built from, as svrngs's own floor holds (update.rs `BUILT`), so
# NEEDS and every release after it are signed later; 1.13.2, the release
# before it, was signed at 1795285495 (`gpg --list-packets` on its
# SHA256SUMS.sig and install.sh.sig). Get svrngs reads the time from those
# signatures, as gpg verified them, never from a page.
SIGNED_SINCE = 1795295535


def older_svrngs(pid):
    """What an svrngs older than the panel says to `--pid <pid>@<start>`
    (svrngs cli.rs `parse`, which reads every flag before the command, and
    `not`): 1.12.1 and before have no --pid (cli.rs:364 at v1.12.1), and
    1.12.2's takes a process id alone (cli.rs:305, :321 at v1.12.2)."""
    return ("unknown argument `--pid`", f"--pid `{pid}` is not a process id")


def run_svrngs(args, stdin="", raw=False, older=()):
    """svrngs's reply to a command, as words for the panel; with `raw`, its
    standard output as printed, too. When svrngs refuses with one of
    `older`, it is older than the panel, and the panel says what to do
    instead: read from what svrngs said before any line is taken out."""
    command = svrngs_command()
    if command is None:
        return {"ok": False, "said": "svrngs is not installed on this computer"}
    try:
        done = subprocess.run([command, *args], input=stdin, capture_output=True, text=True, timeout=30)
    except subprocess.TimeoutExpired:
        return {"ok": False, "said": "svrngs did not finish within 30 seconds"}
    if raw:
        return {"ok": done.returncode == 0, "out": done.stdout, "said": done.stderr.strip()[:4000]}
    if done.returncode != 0 and any(said in done.stderr for said in older):
        return {"ok": False, "code": done.returncode, "said": NEWER}
    # `share` asks for a password on stderr (cli.rs:860). The question is
    # not part of what svrngs said, so it is taken out whole.
    asked = re.sub(r"If .+? takes a password on each request, .+?\(Enter alone for none\):\s*", "", done.stderr, flags=re.S)
    if done.returncode != 0:
        # A refusal is said whole, never cut, whatever it quotes: `svrngs:
        # <why>`, and for what it couldn't parse, a blank line and its
        # usage, which is the terminal's (svrngs main.rs).
        refused = asked.strip().split("\n\n")[0].strip()
        return {"ok": False, "code": done.returncode, "said": refused[:4000] or f"svrngs stopped (exit {done.returncode}) and said nothing"}
    said = "\n".join(part.strip() for part in (done.stdout, asked) if part.strip())
    # Lines that tell a terminal user what to type next (`svrngs unshare …`)
    # are for the terminal; the panel has its own buttons for them.
    plain = "\n".join(
        cut for cut in (re.sub(r"[^.\n]*`[^`\n]*`[^.\n]*\.?", "", line).strip() for line in said.splitlines()) if cut
    )
    return {"ok": True, "code": 0, "said": (plain or said)[:4000]}


# What svrngs says when it doesn't know a port's program and was told none
# (svrngs share.rs `ShareRefusal::NoKind`, in its words at 1.13.1 and
# 1.13.2), the programs it knows after them. Its help says it: --program
# "says which program it is, when svrngs does not know the port; without
# it, svrngs says the programs it knows" (svrngs help.txt).
NO_KIND = re.compile(r"svrngs: say which program is on port \d+\b.*?svrngs knows: (?P<known>[a-z0-9_, -]*)$", re.S)


def lend(args, process, program, secret, older):
    """svrngs's `share` of a port, as svrngs's home page lends one
    (home.rs `lend_one`): by the kind svrngs knows the port for, with the
    terms svrngs ships for it, which a --program given would override
    (share.rs `kind_of`), so svrngs is asked with none first. Only if it
    doesn't know the port is it told `program`, the program the panel
    read there or the person named; with none to tell it, nothing is lent,
    and the reply asks which program it is (`asks`), with the programs
    svrngs knows (`known`). svrngs refuses a port it doesn't know before it
    reads, keeps or asks anything (share.rs `lend_of`), so asking again
    lends it once."""
    done = run_svrngs(args + process, stdin=secret, older=older)
    unknown = None if done["ok"] else NO_KIND.match(done["said"])
    if unknown is None:
        return done
    if program:
        return run_svrngs(args + ["--program", program] + process, stdin=secret, older=older)
    known = [k for k in unknown.group("known").split(", ") if re.fullmatch(r"[a-z0-9_-]{1,64}", k)]
    return {"ok": False, "code": done["code"], "asks": "program", "known": known[:MAX_ROWS],
            "said": f"svrngs doesn't know what answers on port {args[1]}. Say which program it is, then press Lend again."}


# Where a lend with Play on is, as svrngs says it (play.rs `Open`, by its
# `is`, a closed set): open at its address, or closed and why. One this
# helper doesn't know, from a newer svrngs, is "unknown", and not open.
OPENS = ("at", "apart", "unread", "unopened", "taken")


def plays_of(at, secret):
    """What has Play on (svrngs GET /v1/play, play.rs `Playing`): each by its
    lender's key and its name, where a program reaches it (`at`), whether
    it is open there (`open`) and svrngs's words for it. None when svrngs
    couldn't say, which is never read as nothing on."""
    try:
        answer = ask(at, secret, "GET", "/v1/play")
    except (Stopped, Unreadable):
        return None
    if not isinstance(answer, list):
        return None
    found = []
    for p in rows(answer)[0]:
        if not isinstance(p, dict) or key_of(p.get("key")) is None:
            continue
        opened = p.get("open").get("is") if isinstance(p.get("open"), dict) else None
        found.append({"key": p["key"], "name": text(p.get("name")), "at": text(p.get("at")),
                      "open": opened if opened in OPENS else "unknown", "said": text(p.get("said"))})
    return found


def play(key, name, off):
    """Play turned on, or `off`, for the lend `name` of the computer whose
    key is `key` (svrngs POST /v1/play, play.rs `turn`). While it is on, the
    lend's address here, http://<label>.localhost:<svrngs's port>/, lets in
    a program of this account with no key, and takes off any key it sends
    unread (play.rs `shown`); so an app is never given svrngs's token.
    Turned on, the address svrngs answers is copied with v1 on its end, as
    an OpenAI-compatible app takes it, only if it is open there and that
    address is the lend's own on this computer (`lend_at`). An svrngs whose
    Play opens no lend at an address, 1.13.2 and before, has no proof route
    either, and is told to update (NEWER) before it is asked (`proved`)."""
    held, refused = connected()
    if refused:
        return refused
    at, secret = held
    try:
        status, answer = request(at, secret, "POST", "/v1/play", {"off" if off else "on": {"key": key, "name": name}})
    except Stopped:
        return {"ok": False, "said": "svrngs isn't running"}
    except Unreadable as e:
        return {"ok": False, "said": str(e)}
    said = answer.get("error") if isinstance(answer, dict) else None
    if status != 200 or not isinstance(answer, list):
        return {"ok": False, "said": text(said).strip() if isinstance(said, str) and said.strip() else f"svrngs answered {status} and turned nothing"}
    row = next((p for p in answer if isinstance(p, dict) and p.get("key") == key and p.get("name") == name), None)
    if off:
        if row is not None:
            return {"ok": False, "said": f"svrngs still has Play on for {name}"}
        return {"ok": True, "said": f"Play is off for {name}."}
    opened = row.get("open") if row else None
    if not isinstance(opened, dict) or opened.get("is") != "at":
        words = row.get("said") if row else None
        return {"ok": False, "said": text(words) if isinstance(words, str) and words else f"svrngs didn't open {name} with Play"}
    address = row.get("at")
    if not isinstance(address, str) or lend_at(address, at[1]) is None:
        return {"ok": False, "said": f"svrngs opened {name} somewhere other than its address on this computer, so nothing was copied"}
    copier = shutil.which("wl-copy")
    if copier is None:
        return {"ok": False, "said": f"Play is on for {name}, but wl-copy isn't installed, so its address wasn't copied: {address}v1"}
    subprocess.run([copier], input=address + "v1", text=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=5)
    return {"ok": True, "at": address, "address": address + "v1", "said": f"Copied {address}v1."}


def keep_sharing(name, shown, process):
    """Keep sharing the lend `name` to what its row showed answering on its
    port: `shown`, the token the row was listed with, and the process its
    line named, `<pid>@<start>`, a program of this account (`svrngs_now`).
    svrngs approves that only while what answers is what the row listed and
    every socket there is that process's or a child's, so never another
    account's, and changes nothing else of the share (svrngs surface.rs
    `approve`, share.rs `approve`; eudoxia binding.rs `approve`). A pid
    and its start are sent together, as svrngs takes them. Asked of the API
    with the token, as svrngs's home page asks it."""
    held, refused = connected()
    if refused:
        return refused
    at, secret = held
    pid, start = (int(n) for n in process.split("@"))
    asked = {"token": shown, "pid": pid, "start": start}
    try:
        status, answer = request(at, secret, "POST", f"/v1/lends/{name}/approve", asked)
    except Stopped:
        return {"ok": False, "said": "svrngs isn't running"}
    except Unreadable as e:
        return {"ok": False, "said": str(e)}
    said = answer.get("error") if isinstance(answer, dict) else None
    if status == 200 and isinstance(answer, dict):
        return {"ok": True, "said": f"{name} is kept to {answered(answer.get('answers'))} now."}
    if isinstance(said, str) and said.strip():
        return {"ok": False, "said": said.strip()[:1000]}
    return {"ok": False, "said": f"svrngs answered {status} and kept nothing"}


def answered(answers):
    """What answers on a port, as `svrngs approve` says it (cli.rs
    `what_answers`, lend.rs `Answer`): "python3 in ~/garden", or "a program
    of the account root", another account by its name (`account_name`),
    "and" between them."""
    said = []
    for a in answers if isinstance(answers, list) else []:
        if not isinstance(a, dict):
            continue
        if isinstance(a.get("program"), str):
            folder = a.get("folder")
            said.append(text(a["program"]) + (f" in {text(folder)}" if isinstance(folder, str) else ""))
        elif isinstance(a.get("account"), str):
            said.append(f"a program of the account {account_name(a['account'])}")
    return " and ".join(said) if said else "what answers on its port"


def connected():
    """(address, token) of a running svrngs, or a reply saying why not."""
    root = data_dir()
    try:
        at = address(root)
        if at is None:
            return None, {"ok": False, "said": "svrngs hasn't run on this computer yet"}
        return (at, token(root)), None
    except Stopped:
        return None, {"ok": False, "said": "svrngs isn't running"}
    except Unreadable as e:
        return None, {"ok": False, "said": str(e)}


def lend_at(origin, port):
    """The label of a lend's origin, if it is one of svrngs's own on this
    computer (http://<label>.localhost:<svrngs's port>/), else None. Nothing
    else is ever sent the token."""
    match = re.fullmatch(r"http://([a-z0-9]{1,100})\.localhost:(\d{1,5})/", origin or "")
    if not match or int(match.group(2)) != port:
        return None
    return match.group(1)


def models(skip=frozenset()):
    """Friends' lends that answer OpenAI's v1/models through svrngs, asked
    together, each given 4 s. A lend that does not answer is not a model."""
    held, refused = connected()
    if refused:
        return refused
    at, secret = held
    try:
        holding = ask(at, secret, "GET", "/v1/groups")
    except (Stopped, Unreadable) as e:
        return {"ok": False, "said": str(e) or "svrngs isn't running"}
    groups = [g for g in rows(holding.get("groups"))[0] if isinstance(g, dict) and not g.get("left")]
    me = key_of(holding.get("key"))
    candidates = {}
    for g in groups:
        try:
            lent = rows(ask(at, secret, "GET", f"/v1/lends?namespace={g.get('id')}", timeout=LENDS_TIMEOUT).get("lent"))[0]
        except (Stopped, Unreadable):
            continue
        for l in lent:
            # Not asked: this computer's own, by its key, or one its lender
            # says is not running, or holds closed.
            if not isinstance(l, dict) or me is not None and key_of(l.get("key")) == me or l.get("answering") is False or held_of(l.get("held")):
                continue
            label = lend_at(l.get("origin"), at[1])
            if label and label not in candidates and key_of(l.get("key")):
                candidates[label] = {
                    "person": text(l.get("person")),
                    # Its lender's computer, which Play is turned on by.
                    "key": key_of(l.get("key")),
                    "name": text(l.get("name")),
                    "group": text(g.get("name")),
                    "label": label,
                    "address": l["origin"] + "v1",
                }

    def probe(label):
        try:
            proven = dial(at, secret, timeout=4)
        except (Stopped, Unreadable):
            return None
        try:
            reply = proven.send("GET", "/v1/models", headers={"Host": f"{label}.localhost:{at[1]}"})
            raw = reply.read(MAX_BODY + 1)
            # Its lender's program not reached (svrngs answers 502-504): not
            # known, so asked again next time, never remembered as no model.
            if reply.status in (502, 503, 504):
                return None
            if reply.status != 200 or len(raw) > MAX_BODY:
                return []
            listed = json.loads(raw).get("data")
            ids = [text(m.get("id")) for m in listed if isinstance(m, dict) and m.get("id")] if isinstance(listed, list) else []
            return ids[:MAX_ROWS]
        except (ValueError, AttributeError):
            return []
        except (OSError, http.client.HTTPException, Unreadable):
            return None
        finally:
            proven.close()

    # Each candidate with what it answered: its models, [] for none, or null
    # when it was not asked (--skip) or could not be reached.
    asking = [label for label in candidates if label not in skip]
    with ThreadPoolExecutor(max_workers=8) as pool:
        answered = dict(zip(asking, pool.map(probe, asking)))
    lends = [{**c, "models": answered.get(label)} for label, c in candidates.items()]
    found = [l for l in lends if l["models"]]
    return {"ok": True, "models": found, "lends": lends, "asked": len(asking)}


# How long a hand-off page is kept: its address is spent once opened, and
# lapses within a minute anyway (svrngs session.rs).
HANDOFF_AGE = 300


def handoff(url):
    """A page only this person can read, in their runtime directory, that
    sends their browser on to `url`. The one-time address stays out of
    every command line, where other users of the computer could read it
    before it is spent. None when there is no private directory to use."""
    runtime = os.environ.get("XDG_RUNTIME_DIR")
    if not runtime or not Path(runtime).is_dir() or Path(runtime).stat().st_uid != os.getuid():
        return None
    folder = Path(runtime) / "svrngs-fam"
    folder.mkdir(mode=0o700, exist_ok=True)
    folder.chmod(0o700)
    for old in folder.glob("open-*.html"):
        if time.time() - old.stat().st_mtime > HANDOFF_AGE:
            old.unlink(missing_ok=True)
    page = (
        '<!doctype html><meta charset="utf-8"><meta name="referrer" content="no-referrer">'
        f'<meta http-equiv="refresh" content="0;url={url}">'
        f"<title>Opening svrngs</title><script>location.replace({json.dumps(url)})</script>\n"
    )
    fd, path = tempfile.mkstemp(prefix="open-", suffix=".html", dir=folder)
    with os.fdopen(fd, "w") as written:
        written.write(page)
    return Path(path)


def open_in_browser(body):
    """A one-time address from svrngs, opened in the browser here. The
    address never leaves this helper: it is spent once the page opens."""
    held, refused = connected()
    if refused:
        return refused
    at, secret = held
    try:
        answer = ask(at, secret, "POST", "/v1/open", body)
    except (Stopped, Unreadable) as e:
        return {"ok": False, "said": str(e) or "svrngs isn't running"}
    url = answer.get("open")
    if not isinstance(url, str) or not re.fullmatch(r"http://[a-z0-9.-]+\.localhost:\d+/\S*", url):
        return {"ok": False, "said": "svrngs answered no address to open"}
    browser = shutil.which("omarchy-launch-browser") or shutil.which("xdg-open")
    if browser is None:
        return {"ok": False, "said": "no browser to open it in"}
    page = handoff(url)
    if page is None:
        return {"ok": False, "said": "There's no private folder to open it from (XDG_RUNTIME_DIR), so it wasn't opened."}
    subprocess.Popen([browser, page.as_uri()], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    return {"ok": True, "said": "Opened in your browser"}


def invite(group):
    """A new invite link to `group`, copied. svrngs prints the link on its
    own indented line, and the one to open in a browser after it when the
    group keeps a page (svrngs cli.rs Printed)."""
    done = run_svrngs(["link", group], raw=True)
    if not done["ok"]:
        return {"ok": False, "said": done["said"] or "svrngs made no link"}
    links = [line.strip() for line in done["out"].splitlines() if re.fullmatch(r"  \S+", line)]
    browser = [l for l in links if l.startswith("https://")]
    link = (browser or links or [None])[0]
    if link is None:
        return {"ok": False, "said": "svrngs made a link but printed none this helper can read"}
    copier = shutil.which("wl-copy")
    if copier is None:
        return {"ok": False, "said": "wl-copy isn't installed, so the link couldn't be copied"}
    subprocess.run([copier], input=link, text=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=5)
    return {"ok": True, "said": "Invite link copied. It works for a day, while this computer is on."}


# svrngs's releases, each signed by the svrngs release key (svrngs
# RELEASES.md, "Signed releases"). SVRNGS_FAM_RELEASES names one release's
# files directly, for the tests; whose signature they need is only ever the
# key in ../keys.
RELEASES = "https://github.com/alexsbryan/svrngs/releases"
# svrngs's own page, the one svrngs's README starts a group from: where
# svrngs installed from here takes its updates, whatever the invite link.
# svrngs's updater reads that page's get/SHA256SUMS and its signature (svrngs
# update.rs `latest`); the release downloads above have no get/. SVRNGS_FROM
# names another page, as it does for svrngs's own installer (web/install.sh).
PAGE = "https://group.svrnme.sh/"
# A page's address as svrngs keeps one: http(s), no `#` (svrngs-core link.rs
# `Origin`, which install.sh's `from` must be).
PAGE_AT = re.compile(r"https?://[A-Za-z0-9.-]+(:\d{1,5})?(/[^\s#'\"]*)?")
KEYS = Path(__file__).resolve().parent.parent / "keys"
MAX_TEXT_FILE = 1024 * 1024
MAX_ARCHIVE = 64 * 1024 * 1024
# An invite link Get svrngs takes: the https one, whose token is after `#`.
# svrngs's own link, svrngs://join/<token>, is for a computer that has
# svrngs (svrngs-core link.rs `CLIENT_PREFIX`); its installer refuses it
# (web/install.sh:100-102), so it is refused before anything is fetched.
LINK = re.compile(r"https://[A-Za-z0-9.-]+/[^\s'\"]{0,1024}")
CLIENT_LINK = "That link is for a computer that has svrngs already. Empty the box and press Get svrngs, then paste the link under Join a group on your home page."
ARCHES = {"x86_64": "x86_64", "amd64": "x86_64", "aarch64": "aarch64", "arm64": "aarch64"}
# An installer that takes a checked release's file: one whose argument loop
# matches --archive as a case pattern of a line of its own, as svrngs's does
# (web/install.sh:66-67, `--archive | --give-archive)`), not one that only
# says the word, in a comment or a line it prints.
TAKES_ARCHIVE = re.compile(rb"^[ \t]*(?:[-\w*]+[ \t]*\|[ \t]*)*--archive(?:[ \t]*\|[ \t]*[-\w*]+)*[ \t]*\)", re.M)
OLDER_RELEASE = (f"svrngs's latest release is older than {NEEDS}, the first this panel works with, so nothing was installed. "
                 "Try again later. If it still says this, tell svrngs: https://github.com/alexsbryan/svrngs/issues")


def fetch(url, most=MAX_TEXT_FILE):
    """A release file's bytes, at most `most`, or None when the release has
    no such file."""
    try:
        with urllib.request.urlopen(url, timeout=60) as reply:
            data = reply.read(most + 1)
    except urllib.error.HTTPError as e:
        if e.code == 404:
            return None
        raise
    if len(data) > most:
        raise ValueError(f"{url} is larger than {most // 1024} KiB")
    return data


def release():
    """Where one release's files are: the latest, resolved once, so the
    installer, the sums and the archive all come from the same release."""
    named = os.environ.get("SVRNGS_FAM_RELEASES")
    if named:
        return named.rstrip("/")
    asked = urllib.request.Request(f"{RELEASES}/latest", method="HEAD")
    with urllib.request.urlopen(asked, timeout=30) as reply:
        landed = reply.geturl()
    tag = re.fullmatch(r"https://github\.com/alexsbryan/svrngs/releases/tag/(v[0-9][0-9A-Za-z.-]{0,40})", landed)
    if not tag:
        raise ValueError("svrngs's latest release couldn't be found")
    return f"{RELEASES}/download/{tag.group(1)}"


def signed_when(name, data, signature, home):
    """When the svrngs release key, the one key in ../keys whose fingerprint
    is pinned there, signed `data` by `signature`, in seconds since 1970;
    None when `signature` is no good signature of `data` by that key, or
    says no time. Checked in a keyring of its own, which holds that key
    alone."""
    pinned = (KEYS / "svrngs-release-key.fpr").read_text().strip().upper()
    (home / name).write_bytes(data)
    (home / f"{name}.sig").write_bytes(signature)
    gpg = ["gpg", "--batch", "--no-tty", "--homedir", str(home / "gnupg")]
    subprocess.run(gpg + ["--import", str(KEYS / "svrngs-release-key.asc")], capture_output=True, timeout=30, check=True)
    checked = subprocess.run(gpg + ["--status-fd", "1", "--verify", str(home / f"{name}.sig"), str(home / name)],
                             capture_output=True, text=True, timeout=30)
    if checked.returncode != 0:
        return None
    # VALIDSIG names the signing key, then the signature's date and its
    # time, which the signature's hashed part holds (RFC 4880 §5.2.3.4), and,
    # last, its primary key's fingerprint (gnupg doc/DETAILS).
    for v in (line.split() for line in checked.stdout.splitlines() if line.startswith("[GNUPG:] VALIDSIG ")):
        if len(v) > 4 and pinned in (v[2].upper(), v[-1].upper()):
            return seconds(v[4])
    return None


def seconds(said):
    """A time as gpg's status lines say it: seconds since 1970, or an ISO
    8601 time with a T in it (gnupg doc/DETAILS); None for anything else."""
    if said.isdigit():
        return int(said)
    try:
        return calendar.timegm(time.strptime(said, "%Y%m%dT%H%M%S"))
    except ValueError:
        return None


def update_page():
    """The page svrngs installed from here takes its updates from: svrngs's
    own, PAGE, unless SVRNGS_FROM names another; with the `/` install.sh
    puts at its end. None when SVRNGS_FROM names no page."""
    named = os.environ.get("SVRNGS_FROM", "").strip()
    page = named or PAGE
    if not PAGE_AT.fullmatch(page):
        return None
    return page if page.endswith("/") else page + "/"


def get_svrngs(link):
    """svrngs installed by its own installer, for this person alone, without
    root, then their home page opens (svrngs web/install.sh). Everything
    comes from one svrngs release and is checked before anything runs: the
    installer and the release's SHA256SUMS against the svrngs release key,
    each signed no earlier than SIGNED_SINCE, so the release is NEEDS or
    later, whichever GitHub calls latest; and svrngs's archive against
    those sums. The installer is then given
    that archive, so the invite link is used only to join and never to say
    what svrngs is; and it is told svrngs's own page as the page svrngs
    updates from (`update_page`), SVRNGS_FROM, which it keeps over the
    link's (install.sh `from`), so the invite never says what svrngs
    becomes either. What it kept is read back after, and said if it
    isn't that page."""
    if link is not None and link.lower().startswith("svrngs:"):
        return {"ok": False, "said": CLIENT_LINK}
    if link is not None and not LINK.fullmatch(link):
        return {"ok": False, "said": "That doesn't look like a svrngs invite link. Paste the whole link your friend sent."}
    page = update_page()
    if page is None:
        said = text(os.environ.get("SVRNGS_FROM", "").strip())
        return {"ok": False, "said": f"SVRNGS_FROM is {said!r}, which isn't a page's address, so nothing was installed. Set it to the page svrngs should update from, as https://group.svrnme.sh/ is, or unset it."}
    if shutil.which("gpg") is None:
        return {"ok": False, "said": "gpg isn't installed, so svrngs can't be checked. Install gnupg, then try again."}
    arch = ARCHES.get(os.uname().machine)
    if arch is None:
        return {"ok": False, "said": f"svrngs isn't built for this computer ({text(os.uname().machine)})."}
    archive_name = f"svrngs-linux-{arch}.tar.gz"
    try:
        base = release()
        files = {name: fetch(f"{base}/{name}") for name in ("install.sh", "install.sh.sig", "SHA256SUMS", "SHA256SUMS.sig")}
        if all(files.values()):
            files[archive_name] = fetch(f"{base}/{archive_name}", most=MAX_ARCHIVE)
    except (OSError, ValueError) as e:
        return {"ok": False, "said": f"svrngs's release couldn't be read: {text(str(e))}"}
    if not all(files.values()):
        return {"ok": False, "said": "svrngs's latest release has no signed installer for this computer yet. Its README says how to install it: https://github.com/alexsbryan/svrngs#start-a-group"}
    with tempfile.TemporaryDirectory(prefix="svrngs-fam-get-") as directory:
        home = Path(directory)
        (home / "gnupg").mkdir(mode=0o700)
        try:
            signed = [signed_when(name, files[name], files[f"{name}.sig"], home) for name in ("install.sh", "SHA256SUMS")]
        except (OSError, subprocess.SubprocessError):
            signed = [None]
        if None in signed:
            return {"ok": False, "said": "svrngs's release isn't signed by the svrngs release key, so nothing was run."}
        # Each file by its own signature: an older release's installer
        # beside a newer one's sums is an older release too.
        if min(signed) < SIGNED_SINCE:
            return {"ok": False, "said": OLDER_RELEASE}
        listed = sums_of(files["SHA256SUMS"].decode(errors="replace")).get(archive_name)
        if listed is None or hashlib.sha256(files[archive_name]).hexdigest() != listed:
            return {"ok": False, "said": "svrngs's download doesn't match its signed release, so nothing was run."}
        # An installer that would fetch svrngs from the page again can't be
        # given the archive, and isn't run.
        if not TAKES_ARCHIVE.search(files["install.sh"]):
            return {"ok": False, "said": "This svrngs release's installer can't take a checked download yet, so Get svrngs won't run it. svrngs's README says how to install it: https://github.com/alexsbryan/svrngs#start-a-group"}
        archive = home / archive_name
        archive.write_bytes(files[archive_name])
        try:
            done = subprocess.run(["sh", str(home / "install.sh"), link or page, "--archive", str(archive)],
                                  env={**os.environ, "SVRNGS_FROM": page},
                                  stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=600)
        except subprocess.TimeoutExpired:
            return {"ok": False, "said": "svrngs's installer didn't finish within ten minutes."}
    said = "\n".join(line for line in (done.stdout + done.stderr).strip().splitlines()[-6:])
    if done.returncode != 0:
        return {"ok": False, "said": said or f"svrngs's installer stopped (exit {done.returncode})."}
    # The page the installer kept for updates, by the name svrngs's updater
    # reads (svrngs invite.rs `ORIGIN_FILE`, in the data directory).
    try:
        kept = (data_dir() / "origin").read_text().strip()
    except OSError as e:
        return {"ok": False, "said": f"svrngs is installed and running, but which page it takes its updates from can't be read: {e.strerror}."}
    if kept.rstrip("/") != page.rstrip("/"):
        return {"ok": False, "said": f"svrngs is installed and running, but it takes its updates from {text(kept)}, not {page}. Its installer didn't keep the page it was given."}
    return {"ok": True, "said": "svrngs is installed and running. Your home page opens in your browser."}


def sums_of(listing):
    """file name: sha256, from a SHA256SUMS listing."""
    found = {}
    for line in listing.splitlines():
        parts = line.split()
        if len(parts) == 2 and re.fullmatch(r"[0-9a-f]{64}", parts[0]):
            found[parts[1].lstrip("*")] = parts[0]
    return found


class Unasked(Exception):
    """A flag given last, with no value after it."""


def value(rest, flag):
    """What follows `flag` in `rest`; None when `flag` isn't there. A flag
    given last is refused (Unasked), never taken as not given."""
    if flag not in rest:
        return None
    at = rest.index(flag) + 1
    if at >= len(rest):
        raise Unasked(f"{flag} wants a value after it, and none was given")
    return rest[at]


def process_of(rest):
    """(`--pid`'s value, None), or (None, a refusal) when it isn't a process
    and its start as the panel reads them, so svrngs is never run with it."""
    pid = value(rest, "--pid")
    if not re.fullmatch(r"[0-9]{1,7}@[0-9]{1,20}", pid):
        return None, {"ok": False, "said": f"not a process and its start: {text(pid)}"}
    return pid, None


def main(argv):
    """The helper's one JSON answer to `argv`: a flag with no value after it
    is refused, as any argument it can't take is. When this run restarted
    svrngs and svrngs then proved itself (`renewal`), `restarted` says so,
    for the panel to show."""
    try:
        said = answer(argv)
    except Unasked as e:
        said = {"ok": False, "said": str(e)}
    if RESTART["proven"]:
        said["restarted"] = RESTARTED
    return said


def answer(argv):
    if not argv:
        return {"ok": False, "said": __doc__.strip().splitlines()[0]}
    verb, rest = argv[0], argv[1:]
    if verb == "state":
        return state("full" if "--full" in rest else "here" if "--here" in rest else "")
    if verb == "share" and len(rest) >= 3 and rest[0].isdigit():
        port, group, name = rest[:3]
        args = ["share", port, "--group", group, "--name", name]
        program = value(rest, "--program")
        # The process the panel showed, by its pid and start: svrngs lends
        # the port only if that process holds every socket on it, and
        # refuses, saying so, when the pid now names another process.
        pid, process = None, []
        if "--pid" in rest:
            pid, refused = process_of(rest)
            if refused:
                return refused
            process = ["--pid", pid]
        secret = sys.stdin.readline() if "--password-stdin" in rest else ""
        return lend(args, process, program, secret.strip() + "\n", older_svrngs(pid) if pid else ())
    # A held share kept to what its row showed answering on its port: the
    # token the row was listed with, and the process its line named.
    if verb == "approve" and rest:
        if not re.fullmatch(r"[A-Za-z0-9_][A-Za-z0-9_-]{0,63}", rest[0]):
            return {"ok": False, "said": f"not a share's name: {text(rest[0])}"}
        shown = value(rest, "--token")
        if shown is None or not LISTED_WITH.fullmatch(shown):
            return {"ok": False, "said": "approve wants the token its row was listed with: --token <token>"}
        # Only ever to a process of this account's, by its pid and start:
        # never the token alone, which svrngs would take for another
        # account's program on Linux.
        if "--pid" not in rest:
            return {"ok": False, "said": "approve wants the program of yours to keep sharing it to: --pid <pid>@<start>"}
        pid, refused = process_of(rest)
        if refused:
            return refused
        return keep_sharing(rest[0], shown, pid)
    if verb == "unshare" and rest:
        args = ["unshare", rest[0]]
        group = value(rest, "--group")
        if group is not None:
            args += ["--group", group]
        return run_svrngs(args)
    if verb == "play" and len(rest) >= 2:
        key, name = rest[:2]
        if key_of(key) is None or not re.fullmatch(r"[A-Za-z0-9_][A-Za-z0-9_-]{0,63}", name):
            return {"ok": False, "said": f"not a lend's computer and name: {text(key)} {text(name)}"}
        return play(key, name, off="--off" in rest[2:])
    if verb == "models":
        skip = value(rest, "--skip")
        return models(set(skip.split(",")) if skip is not None else set())
    if verb == "open":
        body = {}
        for flag, key in (("--lend", "lend"), ("--at", "at")):
            if value(rest, flag) is not None:
                body[key] = value(rest, flag)
        return open_in_browser(body)
    if verb == "link" and rest:
        return invite(rest[0])
    # svrngs knows what keeps it running (its install line's service, or a
    # package's): `svrngs restart` asks that, and starts it when it's stopped.
    if verb == "start":
        return run_svrngs(["restart"])
    if verb == "get":
        link = value(rest, "--link")
        return get_svrngs(link.strip() if link else None)
    return {"ok": False, "said": f"unknown verb or arguments: {text(' '.join(argv))}"}


if __name__ == "__main__":
    print(json.dumps(main(sys.argv[1:]), ensure_ascii=False))
