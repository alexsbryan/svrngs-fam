#!/usr/bin/python3 -I
"""svrngs.fam's helper: every read and every action the bar plugin takes.

The plugin's QML never reads the token, never builds an HTTP request and
never puts a value from svrngs into a shell string. It runs this helper with
an argv list and reads one JSON object from its standard output.

Verbs:
  state [--full]                  svrngs's state; --full adds what each group
                                  lends and what listens on this computer
  share <port> <group> <name> [--program <kind>] [--password-stdin]
  unshare <name> [--group <group>]
  models                          friends' lends that answer OpenAI's
                                  v1/models, each with the address to use
  open [--lend <label>] [--at <path>]
                                  opens it in the browser, signed in
  link <group>                    makes a new invite link and copies it

It reads svrngs's public surface only: the `svrngs` command, the `api` and
`token` files in svrngs's data directory, and the `/v1/` routes behind the
token. It also reads `lends/*.json` there, a file format svrngs does not
promise, for the one fact no route gives: which port each lend serves.
"""

import http.client
import json
import os
import re
import shutil
import subprocess
import sys
import time
from concurrent.futures import ThreadPoolExecutor
from pathlib import Path

MAX_BODY = 256 * 1024
MAX_ROWS = 200
MAX_TEXT = 200
TIMEOUT = 5.0
LENDS_TIMEOUT = 8.0  # each lender gets up to 3 s to answer (svrngs DESIGN.md:714-727)

# Never offered for lending: ports and programs that act as this person or
# show their sessions. In svrngs's Omarchy testing one Enter on a default row
# lent a browser's debug port (docs/OMARCHY.md §5 G).
DENY_PORTS = {9222, 9229}
DENY_PROGRAMS = {"firefox", "chromium", "chrome", "claude", "cupsd", "svrngs"}
# A lend opened to this Wi-Fi listens at 40000 + hash(label) % 9000
# (svrngs room.rs:63-69).
ROOM_PORTS = range(40000, 49000)


def text(value):
    """A string from svrngs or the system, bounded."""
    s = "" if value is None else str(value)
    return s if len(s) <= MAX_TEXT else s[: MAX_TEXT - 1] + "…"


def rows(values):
    values = list(values or [])
    return values[:MAX_ROWS], len(values) > MAX_ROWS


def data_dir():
    named = os.environ.get("SVRNGS_DIR")
    return Path(named) if named else Path.home() / ".svrngs"


def svrngs_command():
    """The svrngs binary: SVRNGS_FAM_SVRNGS when set (empty for none, as the
    tests set it, so no test reaches a real svrngs), else on PATH, else where
    its install line puts it."""
    if "SVRNGS_FAM_SVRNGS" in os.environ:
        named = os.environ["SVRNGS_FAM_SVRNGS"]
        return named if named and os.access(named, os.X_OK) else None
    found = shutil.which("svrngs")
    if found:
        return found
    candidate = Path.home() / ".local/bin/svrngs"
    return str(candidate) if candidate.is_file() and os.access(candidate, os.X_OK) else None


class Unreadable(Exception):
    """svrngs answered, or something stood in the way, but not as asked."""


class Stopped(Exception):
    """Nothing listens at the address svrngs last kept."""


def address(root):
    """(host, port) from svrngs's `api` file, which names the port it keeps."""
    try:
        line = (root / "api").read_text().strip()
    except FileNotFoundError:
        return None
    match = re.fullmatch(r"http://127\.0\.0\.1:(\d{1,5})/?", line)
    if not match or not 0 < int(match.group(1)) < 65536:
        raise Unreadable(f"its api file says {text(line)!r}, which is not a local address")
    return "127.0.0.1", int(match.group(1))


def token(root):
    try:
        value = (root / "token").read_text().strip()
    except OSError as e:
        raise Unreadable(f"its token cannot be read: {e.strerror}") from None
    if not re.fullmatch(r"[A-Za-z0-9_-]{16,128}", value):
        raise Unreadable("its token file holds no token")
    return value


def ask(at, secret, method, path, body=None, timeout=TIMEOUT):
    """One request to svrngs's API. No Origin is sent: svrngs refuses a request
    that carries one, as coming from a page (api.rs:199-210)."""
    host, port = at
    conn = http.client.HTTPConnection(host, port, timeout=timeout)
    headers = {"Authorization": f"Bearer {secret}"}
    payload = None
    if body is not None:
        payload = json.dumps(body).encode()
        headers["Content-Type"] = "application/json"
    try:
        conn.request(method, path, body=payload, headers=headers)
        reply = conn.getresponse()
        raw = reply.read(MAX_BODY + 1)
    except ConnectionRefusedError:
        raise Stopped() from None
    except (OSError, http.client.HTTPException) as e:
        raise Unreadable(f"{path} did not answer: {e}") from None
    finally:
        conn.close()
    if len(raw) > MAX_BODY:
        raise Unreadable(f"{path} answered more than {MAX_BODY // 1024} KiB")
    try:
        answer = json.loads(raw) if raw else {}
    except ValueError:
        raise Unreadable(f"{path} answered {reply.status} with no JSON") from None
    if reply.status >= 400:
        said = answer.get("error") if isinstance(answer, dict) else None
        raise Unreadable(f"{path} answered {reply.status}: {text(said)}")
    return answer


def own_lends(root):
    """This computer's lends, from their declarations, with the port each serves."""
    folder = root / "lends"
    found = []
    if not folder.is_dir():
        return found
    for path in sorted(folder.glob("*.json")):
        try:
            declared = json.loads(path.read_text())
        except (OSError, ValueError):
            found.append({"name": text(path.stem), "port": None, "readable": False})
            continue
        groups = declared.get("groups") if isinstance(declared, dict) else None
        found.append({
            "name": text(path.stem),
            "port": port_of(declared),
            "groups": [text(g) for g in groups if isinstance(g, str)][:MAX_ROWS] if isinstance(groups, list) else [],
            "readable": True,
        })
    return rows(found)[0]


def port_of(declared):
    """The port in a lend's declaration, wherever its format keeps it."""
    if not isinstance(declared, dict):
        return None
    for key in ("port", "source"):
        value = declared.get(key)
        if isinstance(value, int):
            return value
        if isinstance(value, dict):
            inner = port_of(value) or value.get("Port")
            if isinstance(inner, int):
                return inner
    return None


SS_LINE = re.compile(r"^\S+\s+\d+\s+\d+\s+(?P<local>\S+)\s+\S+\s*(?P<process>.*)$")
SS_PROC = re.compile(r'\(\("(?P<name>[^"]+)",pid=(?P<pid>\d+)')


def listeners(skip_ports):
    """TCP listeners of this user's processes, on loopback or every address.
    `ss -p` names a process only when it is this user's, so an unnamed row is
    someone else's and is never offered."""
    try:
        out = subprocess.run(["ss", "-ltnpH"], capture_output=True, text=True, timeout=TIMEOUT).stdout
    except (OSError, subprocess.TimeoutExpired):
        return None
    seen = {}
    for line in out.splitlines():
        match = SS_LINE.match(line.strip())
        if not match:
            continue
        local = match.group("local")
        host, _, port = local.rpartition(":")
        if not port.isdigit():
            continue
        port = int(port)
        if host not in ("127.0.0.1", "[::1]", "0.0.0.0", "*", "[::]") and not host.startswith("127."):
            continue
        proc = SS_PROC.search(match.group("process"))
        if not proc:
            continue
        name = proc.group("name")
        if port in skip_ports or port in DENY_PORTS or port in ROOM_PORTS or name in DENY_PROGRAMS:
            continue
        pid = int(proc.group("pid"))
        program, offered = describe(pid, name)
        seen.setdefault(port, {"port": port, "program": text(program), "name": offered, "pid": pid})
    return rows(sorted(seen.values(), key=lambda r: r["port"]))[0]


# Puma rewrites its process title: `puma 8.1.2 (tcp://127.0.0.1:3000) [garden]`,
# while `ss` names it `ruby` (S0 (e)).
TITLE = re.compile(r"(?P<program>[A-Za-z][\w.-]*) [^\[]*\[(?P<name>[^\]]+)\]\s*")


def describe(pid, comm):
    """(program, name to offer) for a listener: from its process title when
    it names itself, else its command and the folder it runs in."""
    try:
        argv = Path(f"/proc/{pid}/cmdline").read_bytes().split(b"\0")
        title = argv[0].decode(errors="replace").strip()
    except OSError:
        title = ""
    named = TITLE.fullmatch(title)
    if named:
        return named.group("program"), lend_name(named.group("name"), comm)
    try:
        folder = Path(os.readlink(f"/proc/{pid}/cwd"))
    except OSError:
        folder = None
    if folder is None or folder == Path.home() or folder == Path("/"):
        return comm, lend_name(comm, comm)
    return comm, lend_name(folder.name, comm)


def lend_name(wanted, fallback):
    """A name svrngs takes for a lend: letters, digits and dashes."""
    cleaned = re.sub(r"[^a-z0-9-]+", "-", wanted.lower()).strip("-")[:40].strip("-")
    return cleaned or re.sub(r"[^a-z0-9-]+", "-", fallback.lower()).strip("-") or "app"


def state(full):
    root = data_dir()
    report = {"at": int(time.time() * 1000), "svrngs": None, "groups": [], "mine": [], "command": svrngs_command() is not None}
    try:
        at = address(root)
        if at is None:
            report["svrngs"] = "not-installed" if not report["command"] else "never-started"
            return report
        report["mine"] = own_lends(root)
        secret = token(root)
        held = ask(at, secret, "GET", "/v1/groups")
        groups, over = rows(held.get("groups"))
        report["groups"] = [
            {"id": text(g.get("id")), "name": text(g.get("name")), "person": text(g.get("person")), "left": bool(g.get("left"))}
            for g in groups
            if isinstance(g, dict)
        ]
        report["groupsCut"] = over
        report["svrngs"] = "running"
        if full:
            report["lends"] = {g["id"]: lends_of(at, secret, g["id"]) for g in report["groups"] if not g["left"]}
            skip = {at[1]} | {m["port"] for m in report["mine"] if m["port"]}
            report["listeners"] = listeners(skip)
    except Stopped:
        report["svrngs"] = "stopped"
    except Unreadable as e:
        report["svrngs"] = "unreadable"
        report["reason"] = str(e)
    return report


def lends_of(at, secret, namespace):
    try:
        answer = ask(at, secret, "GET", f"/v1/lends?namespace={namespace}", timeout=LENDS_TIMEOUT)
    except (Unreadable, Stopped) as e:
        return {"error": text(str(e) or "svrngs stopped")}
    lent, over = rows(answer.get("lent"))
    return {
        "lent": [
            {
                "person": text(l.get("person")),
                "name": text(l.get("name")),
                "kind": text(l.get("kind")),
                "origin": text(l.get("origin")),
                "using": l.get("using") if isinstance(l.get("using"), int) else None,
                "limit": l.get("limit") if isinstance(l.get("limit"), int) else None,
            }
            for l in lent
            if isinstance(l, dict)
        ],
        "cut": over,
        "unanswered": [text(p.get("person")) for p in rows(answer.get("unanswered"))[0] if isinstance(p, dict)],
    }


def run_svrngs(args, stdin="", raw=False):
    """svrngs's reply to a command, as words for the panel; with `raw`, its
    standard output as printed, too."""
    command = svrngs_command()
    if command is None:
        return {"ok": False, "said": "svrngs is not installed on this computer"}
    try:
        done = subprocess.run([command, *args], input=stdin, capture_output=True, text=True, timeout=30)
    except subprocess.TimeoutExpired:
        return {"ok": False, "said": "svrngs did not finish within 30 seconds"}
    if raw:
        return {"ok": done.returncode == 0, "out": done.stdout, "said": done.stderr.strip()[:4000]}
    # `share` asks for a password on stderr (cli.rs:1009-1033). The question
    # is not part of what svrngs said, so it is taken out whole.
    asked = re.sub(r"If .+? takes a password on each request, .+?\(Enter alone for none\):\s*", "", done.stderr, flags=re.S)
    said = "\n".join(part.strip() for part in (done.stdout, asked) if part.strip())
    # Lines that tell a terminal user what to type next (`svrngs unshare …`)
    # are for the terminal; the panel has its own buttons for them.
    plain = "\n".join(
        cut for cut in (re.sub(r"[^.\n]*`[^`\n]*`[^.\n]*\.?", "", line).strip() for line in said.splitlines()) if cut
    )
    said = plain or said
    return {"ok": done.returncode == 0, "code": done.returncode, "said": said[:4000]}


def connected():
    """(address, token) of a running svrngs, or a reply saying why not."""
    root = data_dir()
    try:
        at = address(root)
        if at is None:
            return None, {"ok": False, "said": "svrngs hasn't run on this computer yet"}
        return (at, token(root)), None
    except Stopped:
        return None, {"ok": False, "said": "svrngs isn't running"}
    except Unreadable as e:
        return None, {"ok": False, "said": str(e)}


def lend_at(origin, port):
    """The label of a lend's origin, if it is one of svrngs's own on this
    computer (http://<label>.localhost:<svrngs's port>/), else None. Nothing
    else is ever sent the token."""
    match = re.fullmatch(r"http://([a-z0-9]{1,100})\.localhost:(\d{1,5})/", origin or "")
    if not match or int(match.group(2)) != port:
        return None
    return match.group(1)


def models():
    """Friends' lends that answer OpenAI's v1/models through svrngs, asked
    together, each given 4 s. A lend that does not answer is not a model."""
    held, refused = connected()
    if refused:
        return refused
    at, secret = held
    try:
        groups = [g for g in rows(ask(at, secret, "GET", "/v1/groups").get("groups"))[0] if isinstance(g, dict) and not g.get("left")]
    except (Stopped, Unreadable) as e:
        return {"ok": False, "said": str(e) or "svrngs isn't running"}
    candidates = {}
    for g in groups:
        me = g.get("person")
        try:
            lent = rows(ask(at, secret, "GET", f"/v1/lends?namespace={g.get('id')}", timeout=LENDS_TIMEOUT).get("lent"))[0]
        except (Stopped, Unreadable):
            continue
        for l in lent:
            if not isinstance(l, dict) or l.get("person") == me:
                continue
            label = lend_at(l.get("origin"), at[1])
            if label and label not in candidates:
                candidates[label] = {
                    "person": text(l.get("person")),
                    "name": text(l.get("name")),
                    "group": text(g.get("name")),
                    "label": label,
                    "address": l["origin"] + "v1",
                }

    def probe(label):
        conn = http.client.HTTPConnection(at[0], at[1], timeout=4)
        try:
            conn.request("GET", "/v1/models", headers={"Host": f"{label}.localhost:{at[1]}", "Authorization": f"Bearer {secret}"})
            reply = conn.getresponse()
            raw = reply.read(MAX_BODY + 1)
            if reply.status != 200 or len(raw) > MAX_BODY:
                return None
            listed = json.loads(raw).get("data")
            ids = [text(m.get("id")) for m in listed if isinstance(m, dict) and m.get("id")] if isinstance(listed, list) else None
            return ids[:MAX_ROWS] if ids else None
        except (OSError, http.client.HTTPException, ValueError, AttributeError):
            return None
        finally:
            conn.close()

    found = []
    with ThreadPoolExecutor(max_workers=8) as pool:
        for label, ids in zip(candidates, pool.map(probe, candidates)):
            if ids:
                found.append({**candidates[label], "models": ids})
    return {"ok": True, "models": found, "asked": len(candidates)}


def open_in_browser(body):
    """A one-time address from svrngs, opened in the browser here. The
    address never leaves this helper: it is spent once the page opens."""
    held, refused = connected()
    if refused:
        return refused
    at, secret = held
    try:
        answer = ask(at, secret, "POST", "/v1/open", body)
    except (Stopped, Unreadable) as e:
        return {"ok": False, "said": str(e) or "svrngs isn't running"}
    url = answer.get("open")
    if not isinstance(url, str) or not re.fullmatch(r"http://[a-z0-9.-]+\.localhost:\d+/\S*", url):
        return {"ok": False, "said": "svrngs answered no address to open"}
    browser = shutil.which("omarchy-launch-browser") or shutil.which("xdg-open")
    if browser is None:
        return {"ok": False, "said": "no browser to open it in"}
    subprocess.Popen([browser, url], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    return {"ok": True, "said": "Opened in your browser"}


def invite(group):
    """A new invite link to `group`, copied. svrngs prints the link on its
    own indented line, and the one to open in a browser after it when the
    group keeps a page (svrngs cli.rs Printed)."""
    done = run_svrngs(["link", group], raw=True)
    if not done["ok"]:
        return {"ok": False, "said": done["said"] or "svrngs made no link"}
    links = [line.strip() for line in done["out"].splitlines() if re.fullmatch(r"  \S+", line)]
    browser = [l for l in links if l.startswith("https://")]
    link = (browser or links or [None])[0]
    if link is None:
        return {"ok": False, "said": "svrngs made a link but printed none this helper can read"}
    copier = shutil.which("wl-copy")
    if copier is None:
        return {"ok": False, "said": "wl-copy isn't installed, so the link couldn't be copied"}
    subprocess.run([copier], input=link, text=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=5)
    return {"ok": True, "said": "Invite link copied. It works for a day, while this computer is on."}


def main(argv):
    if not argv:
        return {"ok": False, "said": __doc__.strip().splitlines()[0]}
    verb, rest = argv[0], argv[1:]
    if verb == "state":
        return state("--full" in rest)
    if verb == "share" and len(rest) >= 3 and rest[0].isdigit():
        port, group, name = rest[:3]
        args = ["share", port, "--group", group, "--name", name]
        if "--program" in rest:
            args += ["--program", rest[rest.index("--program") + 1]]
        secret = sys.stdin.readline() if "--password-stdin" in rest else ""
        return run_svrngs(args, stdin=secret.strip() + "\n")
    if verb == "unshare" and rest:
        args = ["unshare", rest[0]]
        if "--group" in rest:
            args += ["--group", rest[rest.index("--group") + 1]]
        return run_svrngs(args)
    if verb == "models":
        return models()
    if verb == "open":
        body = {}
        for flag, key in (("--lend", "lend"), ("--at", "at")):
            if flag in rest:
                body[key] = rest[rest.index(flag) + 1]
        return open_in_browser(body)
    if verb == "link" and rest:
        return invite(rest[0])
    return {"ok": False, "said": f"unknown verb or arguments: {text(' '.join(argv))}"}


if __name__ == "__main__":
    print(json.dumps(main(sys.argv[1:]), ensure_ascii=False))
