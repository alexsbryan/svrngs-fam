# svrngs.fam, the Omarchy bar plugin for svrngs, packaged from this
# repository's checkout: `makepkg` here builds the commit checked out.
pkgname=svrngs-fam
pkgver=0.1.0
pkgrel=1
pkgdesc="svrngs in the Omarchy bar: lend what you're building, use your people's models, invite"
arch=('any')
url="https://svrnme.sh"
license=('MIT')
depends=('omarchy' 'svrngs' 'python' 'iproute2' 'wl-clipboard')

package() {
  local src="$startdir/../../.."
  local dest="$pkgdir/usr/share/svrngs-fam"
  install -Dm644 "$src/manifest.json" "$dest/manifest.json"
  install -Dm644 -t "$dest" "$src/Panel.qml" "$src/Service.qml" "$src/Model.js"
  install -Dm644 -t "$dest/i18n" "$src"/i18n/*.json
  install -Dm755 "$src/bin/svrngs-fam" "$dest/bin/svrngs-fam"
  install -Dm755 "$src/setup-user" "$dest/setup-user"
  install -Dm644 "$src/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
